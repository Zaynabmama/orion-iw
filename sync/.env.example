# Orion ERP invoice API - shared across all tenants (one login, one endpoint;
# Company Code inside each payload is what distinguishes tenants). When all
# three are set, main.py logs in and POSTs there instead of writing to the
# local outbox folder.
ORION_BASE_URL=
ORION_USERNAME=
ORION_PASSWORD=

# Microsoft Graph app-only auth (client credentials) for notifier.py's alert
# emails, sent whenever a run has any skipped invoice or failed tenant.
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
GRAPH_SENDER=

# Comma-separated list of addresses to alert when a sync run has skips/failures.
ALERT_RECIPIENTS=

# Per-tenant Mindware BSS credentials now live in tenants/*.json (copy
# tenants/_template.json for each of the 6 tenants), not here.
